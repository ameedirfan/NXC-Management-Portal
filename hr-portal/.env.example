GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
SESSION_SECRET=
# Drive folder the service account uploads trip files into (Trip Itineraries).
# Share this folder with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor, and enable the
# Drive API for the same service account/project used for Sheets above.
GOOGLE_DRIVE_TRIPS_FOLDER_ID=
# OAuth client used to send Recruitment bulk emails as the real NXC society
# Gmail account (a service account cannot send mail as a personal address).
# From the same Google Cloud project as above, OAuth client type "Web
# application", authorized redirect URI http://localhost:3000/api/gmail-auth/callback
# (and the Vercel deployment's equivalent URL once deployed). See the
# "Recruitment bulk email" section in README.md for the full walkthrough.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Obtained once by visiting /api/gmail-auth/start signed in as an admin,
# while authorizing as the NXC society Gmail account. Shown once on the
# callback page, never stored by the app itself.
GOOGLE_GMAIL_REFRESH_TOKEN=
# The NXC society Gmail address itself — the same account you just
# authorized above. Used as the "To" header on a real bulk send (BCC to
# every recipient, To the society's own address). Not looked up via the
# Gmail API on purpose: that needs a broader scope than gmail.send alone,
# and this app only ever sends as this one account anyway.
NXC_GMAIL_ADDRESS=
